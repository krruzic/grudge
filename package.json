{
  "name": "grudge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bake-map": "node --experimental-transform-types --no-warnings tools/bake-map.ts",
    "sim": "node --experimental-transform-types --no-warnings tools/sim.ts",
    "release": "tsc --noEmit && vite build --outDir release --emptyOutDir && vite preview --outDir release --port 5200 --strictPort --host"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
