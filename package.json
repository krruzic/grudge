{
  "name": "grudge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:split4": "VITE_SPLIT4=1 vite",
    "build": "tsc --noEmit && vite build && node --experimental-transform-types --no-warnings tools/precompress.ts dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bake-map": "node --experimental-transform-types --no-warnings tools/bake-map.ts",
    "sim": "node --experimental-transform-types --no-warnings tools/sim.ts",
    "release": "tsc --noEmit && vite build --outDir release --emptyOutDir && vite preview --outDir release --port 5200 --strictPort --host",
    "online": "node tools/online.mjs",
    "serve": "node --no-warnings tools/server.ts",
    "controllers:install": "bash tools/controllers/install.sh",
    "gcadapter:install": "bash tools/gc-adapter/install.sh",
    "gcadapter:status": "bash tools/gc-adapter/status.sh",
    "gcadapter:uninstall": "bash tools/gc-adapter/uninstall.sh",
    "switch2:install": "bash tools/switch2-bt/install.sh",
    "switch2:pair": "bash tools/switch2-bt/pair.sh",
    "determinism": "node --experimental-transform-types --no-warnings tools/determinism.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tools/**/*.{ts,mjs}\""
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "packageManager": "pnpm@11.10.0"
}
