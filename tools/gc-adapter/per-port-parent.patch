+static void gamecube_port_release(struct device *dev)
+{
+}
+
+static void gamecube_ports_add(struct gamecube_adpt *adpt)
+{
+	unsigned int i;
+
+	for (i = 0; i < 4; i++) {
+		struct gamecube_ctrl *ctrl = adpt->ctrls + i;
+
+		device_initialize(&ctrl->port);
+		ctrl->port.parent = &adpt->hdev->dev;
+		ctrl->port.release = gamecube_port_release;
+		if (dev_set_name(&ctrl->port, "gcport%u", i + 1) ||
+		    device_add(&ctrl->port)) {
+			put_device(&ctrl->port);
+			hid_warn(adpt->hdev, "port %u: no sysfs node, browsers may merge pads\n", i + 1);
+			continue;
+		}
+		ctrl->port_added = true;
+	}
+}
+
+static void gamecube_ports_del(struct gamecube_adpt *adpt)
+{
+	unsigned int i;
+
+	for (i = 0; i < 4; i++) {
+		if (!adpt->ctrls[i].port_added)
+			continue;
+		device_del(&adpt->ctrls[i].port);
+		put_device(&adpt->ctrls[i].port);
+		adpt->ctrls[i].port_added = false;
+	}
+}
